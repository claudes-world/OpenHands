# OpenHands Multi-User Deployment Configuration
# Copy this file to .env and update the values for your deployment

# =============================================================================
# SECURITY SETTINGS (REQUIRED - CHANGE THESE!)
# =============================================================================

# JWT secret for authentication tokens (generate a secure random string)
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production_minimum_32_chars

# Application secret key (generate a secure random string)
SECRET_KEY=your_super_secure_app_secret_key_change_this_in_production_minimum_32_chars

# Database password
POSTGRES_PASSWORD=your_secure_database_password_change_this

# MinIO credentials
MINIO_ROOT_USER=openhands_admin
MINIO_ROOT_PASSWORD=your_secure_minio_password_change_this

# Grafana admin password
GRAFANA_PASSWORD=your_secure_grafana_password

# =============================================================================
# OAUTH CONFIGURATION (OPTIONAL)
# =============================================================================

# GitHub OAuth (for GitHub login)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Google OAuth (for Google login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# =============================================================================
# RATE LIMITING AND QUOTAS
# =============================================================================

# Rate limiting (requests per time period)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# User quotas
MAX_CONVERSATIONS_PER_USER=10
MAX_STORAGE_MB_PER_USER=1000

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage backend: "file" or "database"
STORAGE_BACKEND=file

# File storage paths (for development/single-node deployment)
FILE_STORE_PATH=/app/data
USER_WORKSPACE_BASE=/app/workspaces

# S3/MinIO configuration (for production with object storage)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=openhands-workspaces
S3_REGION=us-east-1

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# JWT token expiration (hours)
JWT_EXPIRATION_HOURS=24

# Domain configuration (for production)
DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# Email configuration (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection (automatically set by docker-compose)
DATABASE_URL=postgresql://openhands:${POSTGRES_PASSWORD}@postgres:5432/openhands_multiuser

# Redis connection (automatically set by docker-compose)
REDIS_URL=redis://redis:6379/0

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS
# =============================================================================

# Debug mode (set to false in production)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable/disable user registration
ALLOW_USER_REGISTRATION=true

# =============================================================================
# BACKUP CONFIGURATION (OPTIONAL)
# =============================================================================

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup storage location
BACKUP_STORAGE_PATH=/app/backups

# =============================================================================
# MONITORING CONFIGURATION (OPTIONAL)
# =============================================================================

# Enable metrics collection
ENABLE_METRICS=true

# Metrics endpoint authentication
METRICS_AUTH_TOKEN=your_metrics_auth_token

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker host (for container management)
DOCKER_HOST=unix:///var/run/docker.sock

# Container registry (if using custom images)
CONTAINER_REGISTRY=docker.io

# =============================================================================
# SCALING CONFIGURATION (FOR PRODUCTION)
# =============================================================================

# Number of worker processes
WORKER_PROCESSES=4

# Database connection pool size
DB_POOL_SIZE=20

# Redis connection pool size
REDIS_POOL_SIZE=10

# =============================================================================
# NOTES
# =============================================================================

# To generate secure random strings for secrets, you can use:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# For OAuth setup:
# - GitHub: https://github.com/settings/applications/new
# - Google: https://console.cloud.google.com/apis/credentials
#
# For production deployment:
# 1. Change all default passwords and secrets
# 2. Use a proper domain name
# 3. Enable SSL/TLS certificates
# 4. Configure backup strategy
# 5. Set up monitoring and alerting
# 6. Review security settings
